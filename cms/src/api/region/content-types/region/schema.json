{
  "kind": "collectionType",
  "collectionName": "regions",
  "info": {
    "singularName": "region",
    "pluralName": "regions",
    "displayName": "Region",
    "description": "Countries / regions where the group operates"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "isHeadquarters": { "type": "boolean", "default": false },
    "order": { "type": "integer", "default": 0 },
    "mapX": { "type": "decimal", "min": 0, "max": 100 },
    "mapY": { "type": "decimal", "min": 0, "max": 100 },
    "isoCode": { "type": "string", "regex": "^[a-z]{2}$" }
  }
}
